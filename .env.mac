# ============================================================
# HyperSpace AGI v1.05 — .env per Mac
# Nodo demo stabile della mesh (vedi mesh-machine-roles in memoria:
# "Mac must stay a solid, reliable base for an on-the-fly demo").
# L'hub della mesh è Windows via Tailscale — vedi
# docs/tailscale-mesh-setup.md. Prima di 1.05, Mac e Ubuntu si
# annunciavano a vicenda via tunnel ngrok free-tier, ora morti
# (ERR_NGROK_3200 verificato 2026-09-13).
# ============================================================

# Ollama nativo su questo Mac
OLLAMA_URL=http://host.docker.internal:11434
# Modello servito di default dai nodi (Ollama). MiniCPM5 2B abliterated:
# leggero e universale su CPU/GPU consumer.
#   ollama run hf.co/Abiray/MiniCPM5-2B-heretic-abliterated-GGUF:Q4_K_M
OLLAMA_MODEL=hf.co/Abiray/MiniCPM5-2B-heretic-abliterated-GGUF:Q4_K_M

# Endpoint di QUESTO nodo sulla rete Tailscale.
# 100.81.234.102 = questo Mac (macbook-air-di-alberto) — vedi
# docs/tailscale-mesh-setup.md. Porta 8081 = quella PUBBLICATA
# sull'host per node-1 (non la 8084 interna al container — bug
# reale trovato e corretto il 2026-09-13, verifica sempre contro
# il mapping in docker-compose.yml).
PUBLIC_ENDPOINT=http://100.81.234.102:8081

# Registro condiviso: gira su Windows (hub), raggiungibile via
# Tailscale. Auto-discovery — non serve BOOT_PEERS.
REGISTRY_PUBLIC_URL=http://100.64.31.18:8086

# Apple Silicon: memoria unificata, non VRAM dedicata.
VRAM_GB=0
