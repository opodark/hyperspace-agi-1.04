# ============================================================
# HyperSpace AGI v1.05 — .env per Mac
# Nodo demo stabile della mesh (vedi mesh-machine-roles in memoria:
# "Mac must stay a solid, reliable base for an on-the-fly demo").
# L'hub della mesh è Windows via WireGuard — vedi
# docs/wireguard-mesh-setup.md. Prima di 1.05, Mac e Ubuntu si
# annunciavano a vicenda via tunnel ngrok free-tier, ora morti
# (ERR_NGROK_3200 verificato 2026-09-13).
# ============================================================

# Ollama nativo su questo Mac
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3

# Endpoint di QUESTO nodo sulla VPN WireGuard.
# 10.13.13.2 = Mac — vedi docs/wireguard-mesh-setup.md.
# Finché la VPN non è su, questa mesh cross-machine non funziona:
# verifica prima con `ping 10.13.13.1`.
PUBLIC_ENDPOINT=http://10.13.13.2:8084

# Registro condiviso: gira su Windows (hub), raggiungibile via
# WireGuard. Auto-discovery — non serve BOOT_PEERS.
REGISTRY_PUBLIC_URL=http://10.13.13.1:8086

# Apple Silicon: memoria unificata, non VRAM dedicata.
VRAM_GB=0
