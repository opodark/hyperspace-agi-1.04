# ============================================================
# HyperSpace AGI v1.05 — .env.example
# Copia in .env e modifica solo le variabili che ti riguardano.
# Se valorizzi REGISTRY_PUBLIC_URL i peer vengono scoperti
# automaticamente al boot — non serve BOOT_PEERS. Se lo lasci
# vuoto, questo nodo resta isolato finché non usi BOOT_PEERS
# manuali.
# ============================================================

# ── OBBLIGATORIO ────────────────────────────────────────────
# Il tuo endpoint pubblico (ngrok, tailscale funnel, VPS, ecc.)
# I peer della mesh lo usano per contattarti.
PUBLIC_ENDPOINT=https://il-tuo-tunnel.ngrok-free.app

# ── INFERENCE ───────────────────────────────────────────────
# URL del tuo backend di inferenza locale (Ollama o LM Studio)
OLLAMA_URL=http://host.docker.internal:11434
# Modello servito di default dai nodi (Ollama). MiniCPM5 2B abliterated:
# leggero e universale su CPU/GPU consumer.
#   ollama run hf.co/Abiray/MiniCPM5-2B-heretic-abliterated-GGUF:Q4_K_M
OLLAMA_MODEL=hf.co/Abiray/MiniCPM5-2B-heretic-abliterated-GGUF:Q4_K_M

# ── REGISTRY ────────────────────────────────────────────────
# URL del registry che vuoi usare per l'auto-discovery dei peer.
# Non c'e' (ancora) un registry pubblico ufficiale del progetto:
# questo va puntato al TUO registry condiviso, se ne hai uno
# (es. l'hub della tua mesh privata multi-macchina — vedi
# docs/tailscale-mesh-setup.md per un esempio completo con
# Tailscale). Vuoto = nessuna auto-discovery, solo BOOT_PEERS
# manuali o nodo singolo.
REGISTRY_PUBLIC_URL=

# ── OPZIONALI ───────────────────────────────────────────────
# Tier forzato del nodo: root | hub | leaf (lascia vuoto = auto)
# NODE_TIER=hub

# VRAM del tuo GPU in GB (0 = CPU only, auto-detected se nvidia-smi presente)
# VRAM_GB=8

# Secondi prima che un peer venga marcato stale (default 120)
# PEER_MAX_AGE_S=120

# Secondi TTL nodi nel registry (default 300)
# NODE_TTL=300

# Porta locale del nodo (default 8084)
# NODE_PORT=8084

# Firma crittografica inter-nodo (default true — non disabilitare in produzione)
# SIGN_REQUESTS=true

# Peer manuali da contattare al boot (opzionale — auto-discovery se vuoto)
# BOOT_PEERS=https://peer1.ngrok-free.app,https://peer2.ngrok-free.app

# Control plane URL (solo se hai un CP separato dalla mesh pubblica)
# CONTROL_PLANE_URL=https://il-tuo-cp.ngrok-free.app

# Porta locale del wizard di primo avvio (default 8088, http://localhost:8088)
# ONBOARDING_PORT=8088

# Etichetta libera per identificare a colpo d'occhio a cosa serve il nodo
# NODE_SPECIALIZATION=generalist

# Emoji che rappresenta il nodo nelle dashboard
# NODE_AVATAR=🤖

# ── FALLBACK ESTERNO (OmniRoute) ───────────────────────────────
# Ultimo livello di fallback quando nessun nodo della mesh (locale o
# federato) può rispondere: inoltra la richiesta a OmniRoute
# (https://github.com/diegosouzapw/OmniRoute), gateway verso 278+ provider
# AI esterni. Funziona già senza configurazione (provider free-tier di
# default). Per collegare provider propri: apri http://<host>:20128 dalla
# dashboard e copia la API key da Endpoints.
# OMNIROUTE_ENABLED=true
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=auto

# Compressione prompt (Caveman, via l'endpoint reale di OmniRoute) per i
# prompt lunghi diretti ai nodi della mesh locale — disattivata di default,
# perché comprime il fraseggio e va testata sul proprio caso d'uso prima di
# attivarla. modes: lite | standard | aggressive | ultra | rtk | stacked.
# PROMPT_COMPRESSION_ENABLED=false
# PROMPT_COMPRESSION_MODE=standard
# PROMPT_COMPRESSION_MIN_CHARS=200

# Secondi massimi che una richiesta aspetta in coda su un nodo saturo prima
# di ricevere 503 node_busy_timeout — il control-plane a quel punto prova
# il nodo successivo per score (default 10)
# REQUEST_QUEUE_TIMEOUT_S=10

# Quanti nodi candidati (per score) il control-plane prova in sequenza
# prima di ricadere su ollama-direct/federazione (default 3)
# ROUTING_MAX_CANDIDATES=3

# Pesi dello scoring di routing (VRAM pesa di più: i nodi CPU-only, anche
# se liberi, sono strutturalmente lenti e vanno preferiti solo come ultima
# risorsa). Non serve che sommino esattamente a 1 — sono pesi relativi.
# ROUTING_WEIGHT_VRAM=0.55
# ROUTING_WEIGHT_LOAD=0.25
# ROUTING_WEIGHT_TIER=0.10
# ROUTING_WEIGHT_UPTIME=0.10

# Capacità del nodo in "slot" = numero di richieste/generazioni CONCORRENTI
# di default. Da v1.05 il load control è ADATTIVO (metriche, non unità
# statiche): il nodo tiene i conteggi attivi, misura latenza/tok/s e alza o
# abbassa la concorrenza (algoritmo AIMD) finché non compare il degrado
# (~2x la latenza di riferimento auto-calibrata). Regola i punti di partenza;
# sotto carico il sistema si auto-regola per backend_type.
#
#   model_manager     -> capacità fissa 1 (esegue le richieste in sequenza:
#                        niente parallelismo, "più di 1" non serve).
#   inference_server  -> parte da LOAD_SEED_CONCURRENCY e poi AIMD tra
#                        LOAD_MIN_CONCURRENCY e LOAD_MAX_CONCURRENCY.
#
# LOAD_SEED_CONCURRENCY=4    (seed AIMD per inference_server)
# LOAD_MIN_CONCURRENCY=1     (minimo: non si scende sotto 1)
# LOAD_MAX_CONCURRENCY=16    (tetto massimo)
# LOAD_INCREASE_STEP=1       (additive increase lato "sano")
# LOAD_SHRINK_FACTOR=0.5     (multiplicative decrease al degrado)
# LOAD_HEALTHY_PCT=25        (sotto questa soglia la concorrenza sale;
#                             tra questa e DEGRADED resta in PLATEAU)
# LOAD_DEGRADED_PCT=100      (~2x latenza di base: rifiuta nuovo lavoro)
# LOAD_TPS_COLLAPSE_PCT=40   (se il tok/s crolla sotto il 40% del riferimento)
# LOAD_QOS_POLL_S=8          (cadenza del controllo QoS)
# REQUEST_QUEUE_TIMEOUT_S: vedi sopra (coda breve, default 10 sul nodo).

# Motore d'inferenza servito da questa installazione — letto sia dal nodo
# (esposto in /status per lo scoring) sia dal control-plane (label nel
# fallback ollama-direct). Un solo valore, propagato a entrambi i servizi
# da docker-compose.yml.
# INFERENCE_BACKEND=ollama

# Peso dello scoring dedicato al PARADIGMA di serving (backend_type:
# inference_server vs model_manager), lato control-plane. Il nome della
# variabile resta ROUTING_WEIGHT_ENGINE per retro-compatibilità, ma il
# punteggio non classifica più i singoli prodotti (vllm/ollama/...): solo
# il backend_type, la cui mappatura motore -> tipo vive in
# node/backend_metrics.py (_CAPABILITY_PROFILES).
# ROUTING_WEIGHT_ENGINE=0.15

# Punteggio 0..1 per backend_type, lato control-plane. JSON
# {"tipo": punteggio}. Tipi non elencati ricadono su
# BACKEND_TYPE_SCORE_DEFAULT (0.5). Tipi riconosciuti:
# inference_server, model_manager.
# BACKEND_TYPE_SCORES={"inference_server":1.0,"model_manager":0.5}
# BACKEND_TYPE_SCORE_DEFAULT=0.5

# Blocco QUALITÀ dello scoring ibrido (in funzione delle metriche osservate
# sui nodi via /metrics): latenza e throughput dominano quando i campioni
# sono freschi; il blocco strutturale sopra fa da fallback.
# ROUTING_WEIGHT_LATENCY=0.45
# ROUTING_WEIGHT_TPUT=0.35
# ROUTING_WEIGHT_GPU=0.20

# Bilanciamento: penalità "ultimo scelto" — il nodo appena usato viene
# lievemente depenalizzato con decadimento esponenziale nella finestra.
# Piccola a default: rompe i pareggi tra nodi di pari valore.
# ROUTING_RECENT_PENALTY=0.10
# ROUTING_RECENT_WINDOW_S=45


# ── TELEMETRIA NODI (/metrics) ──────────────────────────────
# Il nodo espone GET /metrics (capability + runtime per modello + load);
# il control-plane lo interroga a cadenza indipendente dall'heartbeat di
# /status e lo espone in GET /metrics/nodes (ultimo campione + storico per
# mini-grafici + breakdown dello score). Questa sezione regola affidabilità
# e cadenza della telemetria.

# ── NODO ───────────────────────────────────────────────────
# TTL della cache del payload /metrics sul nodo (secondi): evita di
# ricontattare il backend (Ollama /api/ps, vLLM /metrics) a ogni poll del
# control-plane. Va tenuto AL DI SOTTO dell'intervallo di poll del CP:
# se lo alzi oltre METRICS_POLL_INTERVAL_S, più poll consecutivi
# riceveranno lo stesso payload (campioni identici nello storico).
# METRICS_CACHE_TTL_S=8

# EWMA tok/s e latenza per modello. Finestra PER MODELLO (non globale):
# ogni modello tiene le ultime METRICS_EWMA_MODEL_WINDOW interazioni, così
# un modello molto usato non "ruba" la finestra a quelli usati raramente.
# I campioni vengono letti dalle ultime METRICS_EWMA_READ_MAX righe di
# memory.jsonl (limite di I/O). METRICS_EWMA_WINDOW resta come alias
# retrocompatibile di READ_MAX.
# METRICS_EWMA_READ_MAX=2000
# METRICS_EWMA_MODEL_WINDOW=50

# Decay temporale dell'EWMA: ogni campione pesa 0.5^(età / half_life).
# I dati recenti contano di più, ma quelli vecchi NON vengono scartati
# (restano visibili, depotenziati): l'indicazione della metrica rimane anche
# quando mancano misurazioni fresche, e runtime.<modello>.data_age_s ne
# dichiara la vetustà. 1800 = metà peso dopo 30 minuti.
# METRICS_EWMA_HALF_LIFE_S=1800

# Smussatura esponenziale (0..1): più basso = più stabile, più alto =
# più reattivo. Usato insieme al decay temporale.
# METRICS_EWMA_ALPHA=0.25

# Solo se INFERENCE_BACKEND=vllm: endpoint Prometheus del server vLLM,
# URL del suo /v1/models e lista modelli (se vuoto viene letta da
# /v1/models al volo).
# VLLM_METRICS_URL=http://vllm:9100/metrics
# VLLM_URL=http://vllm:8000
# VLLM_MODELS=meta-llama/Llama-3.1-8B-Instruct,deepseek-r1:14b

# ── CONTROL-PLANE ──────────────────────────────────────────
# Cadenza del poll di /metrics sui nodi (secondi). Lo stato operativo
# (/status, routing) resta sull'heartbeat separato.
# METRICS_POLL_INTERVAL_S=20

# Timeout per ogni fetch di /metrics verso un nodo (secondi).
# METRICS_POLL_TIMEOUT_S=4

# Finestra in-memory dei campioni per nodo: lunghezza dello storico
# esposto in /metrics/nodes (history) per i mini-grafici.
# METRICS_WINDOW=20

# Fetch dei nodi in PARALLELO (thread): la versione seriale sforerebbe
# l'intervallo con molti nodi. Limita la concorrenza massima.
# METRICS_MAX_WORKERS=8

# Backoff sui nodi irraggiungibili: un nodo giù NON viene martellato a ogni
# ciclo. next_try = now + min(BASE * 2^fallimenti, MAX). Lo storico resta
# servito con stale=true finché il nodo non torna raggiungibile.
# METRICS_BACKOFF_BASE_S=10
# METRICS_MAX_BACKOFF_S=120

# Un campione è marcato stale in /metrics/nodes quando ha più di
# 2 × METRICS_POLL_INTERVAL_S secondi (un ciclo di poll saltato o nodo giù);
# sample_age_s espone l'età esatta.

# ── CODE SANDBOX ─────────────────────────────────────────────────────────────
# Workspace offline per sviluppo e test agentico. Il runner non ha rete,
# Docker socket o accesso in scrittura al repository operativo. Disabilitato
# per default: vedi docs/code-sandbox.md.
# CODE_SANDBOX_ENABLED=false
# Preferisce Docker Sandboxes (microVM via hostctl); se non disponibile usa
# automaticamente il runner container offline definito in Compose.
# SBX_SANDBOX_ENABLED=true
# SBX_EXECUTABLE=
# SBX_SOURCE_DIR=
# SBX_CPUS=2
# SBX_MEMORY=4g
# SANDBOX_MAX_WORKSPACES=6
# SANDBOX_MAX_TIMEOUT=120
# SANDBOX_MAX_FILE_BYTES=1048576
# SANDBOX_JOB_TIMEOUT=240

# Sogno notturno di sviluppo: al massimo una proposta al giorno, soltanto
# dopo inattivita' prolungata e nella finestra locale indicata. La patch viene
# verificata in un secondo workspace pulito e non viene mai applicata da sola.
# NIGHTLY_DEV_ENABLED=false
# NIGHTLY_DEV_START_HOUR=1
# NIGHTLY_DEV_END_HOUR=5
# NIGHTLY_DEV_IDLE_SECONDS=3600
# NIGHTLY_DEV_MODEL=

# ── WEB NODE (worker nel browser) ───────────────────────────────────────────
# Un tab del browser che entra nella mesh servendo SOLO task web-safe
# (summarize, validate_json, moderate e, se il browser offre un runtime adatto,
# translate / embed_texts). Non e' indirizzabile: si registra e poi fa
# long-poll dei task, quindi non riceve mai inferenza pesante. Vedi
# docs/web-node.md e web-node/README.md.
#
# ATTENZIONE al long-poll: ogni poll occupa un thread del control-plane fino a
# WEB_NODE_MAX_POLL_S secondi. Il server deve girare multi-thread (Flask
# builtin o gunicorn con worker threaded), altrimenti due web node si bloccano
# a vicenda.
# WEB_NODE_ENABLED=true
# WEB_NODE_MAX_NODES=64
# WEB_NODE_MAX_QUEUE=32
# WEB_NODE_MAX_PAYLOAD_BYTES=65536
# WEB_NODE_TASK_TTL_S=60
# WEB_NODE_MAX_POLL_S=30
# WEB_NODE_HEARTBEAT_S=30
#
# Accodare un task e' un'azione operatore: POST /web/tasks richiede l'header
# X-Hyperspace-Network-Token, quindi NETWORK_ADMIN_TOKEN qui sotto.

# ── MCP (runtime esterni: Hermes, Claude, altri client) ──────────────────────
# /mcp espone i tool a runtime ESTERNI, quindi non ha un default aperto: senza
# un token configurato risponde 503 e non serve nessuno. Vedi docs/hermes.md.
#
# Un cliente per runtime, con un token di almeno 32 caratteri. Il nome del
# cliente finisce nei log di audit (type=mcp) e in /mcp/status.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# MCP_CLIENTS="hermes=<token>;ops=<token>"
#
# Allowlist dei tool per cliente. "*" = tutto il catalogo pubblicato. Un cliente
# SENZA voce qui non riceve nessun tool (fail-closed): e' voluto, cosi' una
# svista di configurazione non apre tutto il catalogo a un runtime esterno.
# MCP_CLIENT_TOOLS="hermes=omega_query,omega_store,get_mesh_status;ops=*"
#
# Scorciatoia opt-in per sviluppo: con true /mcp accetta anche richieste senza
# token provenienti dal solo loopback. Lasciare false appena il CP e'
# raggiungibile da un'altra macchina.
# MCP_ALLOW_LOOPBACK=false
#
# Spegne MCP senza rimuovere i segreti.
# MCP_ENABLED=true

# ── CONNETTORI ESTERNI (GitHub, Microsoft 365, Google Workspace) ─────────────
# Un connettore si auto-abilita SOLO quando le sue credenziali esistono: senza
# di esse i suoi tool non vengono pubblicati (né nel tool loop della chat, né
# nel catalogo MCP, né su /tools/execute) e non c'è nessun errore da
# interpretare. Chi è attivo, con quali tool e PERCHÉ gli altri sono spenti:
#
#   GET /connectors        (oppure tab Setup -> pannello "Connettori")
#
# Le stesse voci sono modificabili dalla tab Setup del control-plane, che le
# salva qui e RICOSTRUISCE i connettori senza riavviare il container.
# Guida completa (permessi minimi, verifica, troubleshooting): docs/connectors.md
#
# SCRITTURA: i tool con effetti collaterali (inviare email, creare issue ed
# eventi) NON vengono nemmeno esposti al modello finché non li si abilita
# esplicitamente. Servono ENTRAMBE le condizioni:
#   CONNECTOR_READ_ONLY=false
#   CONNECTOR_WRITE_TOOLS="github=github_create_issue;o365=*"   # '*' = tutte le scritture di quel connettore
# Il default è read-only. Cosa resta bloccato lo dice "write_tools_blocked" in GET /connectors.
# CONNECTOR_READ_ONLY=true
# CONNECTOR_WRITE_TOOLS=
#
# GitHub — Personal Access Token (o token di GitHub App) con scope `repo`, che
# copre issues e pull request in lettura/scrittura.
#   https://github.com/settings/tokens
# GITHUB_TOKEN=
# CONNECTOR_GITHUB_ENABLED=true
#
# Microsoft 365 / Graph — app daemon (nessun redirect URI) con permessi
# APPLICATION (non Delegated): Mail.Read Mail.Send Calendars.ReadWrite
# Files.ReadWrite.All.
#   https://portal.azure.com -> Entra ID -> App registrations -> New
#   -> Certificates & secrets -> new client secret
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=common
# CONNECTOR_OFFICE365_ENABLED=true
#
# Google Workspace — service account con Gmail API, Calendar API e Drive API
# abilitate nel progetto GCP. GOOGLE_CREDENTIALS_JSON è il contenuto del JSON su
# UNA riga (va incollato intero: in dashboard è mascherato).
# GOOGLE_DELEGATE_EMAIL serve per l'impersonificazione domain-wide: senza, il
# connettore parla a nome del service account, che di norma non ha una mailbox.
#   https://console.cloud.google.com -> IAM & Admin -> Service Accounts
#   -> Keys -> Add key -> Create new key -> JSON
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_DELEGATE_EMAIL=
# CONNECTOR_GOOGLE_ENABLED=true
#
# /tools/execute (la route che esegue un singolo tool via HTTP, es. dal Tool
# custom di Open WebUI) è protetta dallo stesso token delle azioni di rete:
# NETWORK_ADMIN_TOKEN qui sotto, header X-Hyperspace-Network-Token.
#
# Regolazioni opzionali (cambiano la latenza, non il comportamento):
# GITHUB_TIMEOUT_S=10     timeout per chiamata GitHub
# GITHUB_RETRY_S=1        attesa prima dell'unico ritentativo su 5xx/rete
#                         (solo metodi idempotenti: mai sui POST, per non
#                         creare due volte la stessa issue)
# GOOGLE_TIMEOUT_S=20     timeout per chiamata Google
# O365_TOKEN_DIR=         cache del token Microsoft 365
#                         (default: $DATA_DIR/o365; prima era /tmp, che non
#                         esiste su Windows e non sopravvive ai riavvii)
#
# Circuit breaker: dopo N errori consecutivi il connettore va in pausa e le
# chiamate successive rispondono subito invece di pagare il timeout a ogni
# richiesta del modello. Un successo azzera il contatore; salvare questa
# sezione azzera anche una pausa in corso.
# CONNECTOR_FAILURE_THRESHOLD=3
# CONNECTOR_COOLDOWN_S=60

# ── PERSONA / IDENTITÀ DELL'AGENTE ──────────────────────────────────────────
# Chi è l'agente quando parla con una persona: nome, valori, confini, capacità e
# limiti REALI, iniettati nel system prompt delle richieste di chat (il prompt
# del client viene preservato: il blocco si aggiunge). Se la domanda riguarda
# cosa è l'agente, scatta il vincolo a dichiararsi IA — e la decisione finisce
# nei log. Stato completo (identità + annotazioni su di sé): GET /persona
# Guida: docs/persona.md
# PERSONA_ENABLED=true
# PERSONA_NAME=HyperSpace
# File del documento di identità (vuoto = $DATA_DIR/persona.json).
# PERSONA_FILE=
# Peer federato della sorella maggiore, a cui il tool ask_aurora inoltra le
# domande ("chiede consiglio ad Aurora"). Vuoto = primo peer federato abilitato.
# SISTER_PEER_LABEL=win11-cp
# ── SOGNO DI IDENTITÀ (self-model notturno) ────────────────────────────────
# L'agente riflette su di sé quando nessuno lo usa e scrive PROPOSTE di
# annotazioni in un diario. Nessuna proposta entra nell'identità da sola: la
# revisione è umana (POST /persona/dreams/<id>/review con DREAM_REVIEW_TOKEN).
# Guida: docs/persona.md
# PERSONA_DREAM_ENABLED=false          # true = una riflessione per notte
# PERSONA_DREAM_START_HOUR=4           # finestra locale in cui può partire
# PERSONA_DREAM_END_HOUR=7
# PERSONA_DREAM_IDLE_S=1800            # secondi di silenzio prima di sognare
# PERSONA_DREAM_MAX_TOKENS=320         # tetto della riflessione (max 3 proposte)
# PERSONA_DREAM_MODEL=                 # vuoto = modello dei canali. Di notte
#                                      # nessuno aspetta: qui il modello più
#                                      # grande, in chat quello veloce
# ── MEMORIA (cosa l'agente ricorda della stanza) ────────────────────────────
# "hermes" = il bridge Hermes: se NON è attivo le scritture si perdono in
# silenzio (l'agente non ricorda nulla e il sogno non ha materiale).
# "legacy" = file gzip locale, nessun servizio in più.
# MEMORY_BACKEND=legacy
# MEMORY_FILE=/app/memory/memory.json.gz   # dentro un volume: senza, ogni
#                                          # rebuild cancella la memoria
#
# Memoria locale-prima (shared/memory_sync.py). Con il backend "hermes" e il peer
# spento, una scrittura NON si perde: va nel mirror locale e in coda, e viene
# riconsegnata quando Hermes torna (idempotente: nessun doppione). Il mirror è il
# file `MEMORY_FILE` scritto sempre: si legge a occhio quando si dubita di cosa la
# macchina sa, risponde alle letture quando Hermes tace, ed è la fonte del rollback.
# MEMORY_MIRROR=true                # false = nessuna scrittura locale. Il mirror
#                                   # raccoglie anche ciò che si legge da Hermes:
#                                   # è "cosa questa macchina ricorda", non solo
#                                   # cosa ha scritto lei
# MEMORY_OUTBOX=true                # false = una scrittura non arrivata è persa
# MEMORY_READ_FALLBACK=local        # "fail" = 503 invece della vista locale
# MEMORY_OUTBOX_FILE=               # vuoto = memory-outbox.jsonl accanto a MEMORY_FILE
# MEMORY_SYNC_FLUSH_S=60            # minimo fra due riconsegne della coda

# ── CANALI ESTERNI (chat e privati di una piattaforma che il CP non raggiunge) ─
# Un "canale" è un driver (fuori dal repo: browser + selettori) che legge la
# conversazione e il control-plane che decide: chi è spam, quando rispondere,
# cosa scrivere (con l'identità dichiarata) e l'audit sulle risposte. Il driver
# tira le decisioni da /channel/* e riferisce l'esito.
# Guida completa: docs/channel.md
#
# Senza CHANNEL_CLIENTS nessuna route /channel/* risponde (fail-closed), come MCP.
# Genera i token con: python -c "import secrets; print(secrets.token_hex(32))"
# CHANNEL_CLIENTS="cam4=<token>;cb=<token>"
# CHANNEL_ENABLED=true
#
# Modello che scrive nei canali (vuoto = default del control-plane). In una
# stanza conviene piccolo e veloce: le risposte sono una battuta.
# CHANNEL_MODEL=
#
# Una scheda, un modello: prima di accodare un'immagine il control-plane chiede a
# Ollama di scaricare CHANNEL_MODEL (keep_alive: 0). Su una scheda da 8 GB il
# diffusion e il modello della chat non stanno insieme, e la contesa si presentava
# come "CUDA error: unknown error" (2026-09-22: 6.2 GB a Ollama, 1.7 liberi). Il
# modello si ricarica alla prima richiesta: si paga qualche secondo al primo
# messaggio dopo un'immagine. `false` per spegnere su macchine con più memoria.
IMAGE_FREE_GPU=true
#
# Discord come terzo canale: aggiungi discord=<token> a CHANNEL_CLIENTS.
# CHANNEL_OPERATOR=alberto   # chi è "io" nel dialogo interno a due voci (alias separati da virgola)
#
# Effetto Tamagotchi: poca mesh -> modelli piccoli e risposte essenziali; mesh
# ricca -> (sopra VITALITY_BIG_LEVEL) il modello grande, se disponibile.
# VITALITY_BIG_LEVEL=3
# VITALITY_BIG_MODEL=gemma4:e4b
#
# Ritmo e moderazione (tutte modificabili anche dalla tab Setup):
# I default (25 / 6 / 6) sono tarati per una STANZA affollata, dove il bot non deve
# rispondere a ogni riga. In una CHAT a due sembra spenta: 8 secondi fra due
# risposte, batch che matura in 3 secondi, 3 messaggi. Misurato il 2026-09-22.
# CHANNEL_MIN_REPLY_INTERVAL_S=8    # intervallo minimo fra due risposte (default 25)
# CHANNEL_BATCH_MAX_AGE_S=3         # età perché un batch sia maturo (default 6)
# CHANNEL_BATCH_MAX_MESSAGES=3      # quanti messaggi perché sia maturo (default 6)
# CHANNEL_REPLY_PROBABILITY=1.0     # < 1 ogni tanto lascia correre
# CHANNEL_FLOOD_MAX=6               # messaggi oltre i quali è "raffica"
# CHANNEL_STRIKE_MUTE=2             # strike per il mute (al 1° non si punisce)
# CHANNEL_STRIKE_BAN=3              # strike per il ban
# Contesto della stanza che il modello vede: alzare se il bot "non ricorda" le
# ultime battute, abbassare se perde il filo. Valgono subito, anche da Setup.
# In chat, 12/4096 dimezza il prompt e la risposta arriva in 0.9-6.6 s invece di ~15.
# CHANNEL_CONTEXT_MESSAGES=12       # quanti degli ultimi messaggi entrano nel prompt
# CHANNEL_CONTEXT_CHARS=400         # troncamento di ogni singolo messaggio
# CHANNEL_NUM_CTX=4096              # finestra chiesta a Ollama (num_ctx): senza,
#                                   # usa il suo default e taglia l'inizio del
#                                   # prompt — cioè identità e confini
#
# Lato driver: CHANNEL_URL (default http://127.0.0.1:8088) e CHANNEL_TOKEN
# (vuoto = il driver resta autonomo col proprio modello locale).
# Il driver ha anche CHANNEL_TIMEOUT_S (default 20s): con 20 messaggi di contesto
# una battuta arriva in ~16s, quindi conviene alzarlo (scripts/start.ps1 lo porta
# a 35s quando lancia il driver in stanza).

# ── DREAM REVIEW ────────────────────────────────────────────────────────────
# Autorizza le decisioni manuali nella Dream Review Inbox. Deve avere almeno
# 32 caratteri ed essere uguale nel control-plane e nei nodi (l'env_file è
# condiviso nei profili Compose). Se assente, inbox e insight restano leggibili
# ma promote/reject/defer/reopen/revoke sono disabilitati.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# DREAM_REVIEW_TOKEN=

# ── PANNELLO NETWORK (ngrok / Tailscale / WireGuard) ─────────────────────────
# WireGuard/Tailscale/ngrok girano sull'HOST, non in questo container: il
# control-plane non può lanciare `tailscale status` o `wg show` da qui dentro.
# hostctl/agent.py gira nativo sull'host ed espone questo stato via HTTP;
# vedi docs/network-panel.md per il setup completo (incluso sudoers per
# wg-quick). Disattivato finché HOSTCTL_TOKEN non è impostato — nessun
# default silenzioso.
#
# Genera entrambi i token con: python3 hostctl/agent.py --generate-token
# HOSTCTL_TOKEN=

# Token separato browser -> control-plane per status, azioni host e annuncio
# bottle. Va inserito nella tab Network; resta nel sessionStorage del browser.
# Non riusare HOSTCTL_TOKEN: quello e' esclusivamente server-to-server.
# NETWORK_ADMIN_TOKEN=

# ── TOOL & SKILL FORGE / BROWSER IDE ────────────────────────────────────────
# Optional localhost-only code-server profile used to inspect Forge drafts.
# Start with: docker compose -f docker-compose.windows.yml --profile ide up -d hyperspace-ide
# CODE_SERVER_PORT=8443
# CODE_SERVER_PASSWORD=

# Explicit approval token for Forge artifacts. Draft creation and editing do
# not publish or execute artifacts; approval records the human review decision.
# FORGE_ADMIN_TOKEN=

# Porta su cui ascolta hostctl/agent.py sull'host (default 8765).
# HOSTCTL_PORT=8765

# IP specifico su cui ascolta hostctl. 127.0.0.1 funziona con Docker Desktop
# macOS/Windows. Su Linux il container non puo' raggiungere il loopback host:
# usa l'IP del bridge Docker (spesso 172.17.0.1), protetto dal token e dal
# firewall. Wildcard 0.0.0.0/:: sono sempre rifiutati dall'agent.
# HOSTCTL_BIND=127.0.0.1

# URL con cui il control-plane raggiunge l'host-agent. host.docker.internal
# risolve verso l'host su tutte e tre le piattaforme (Mac/Windows via Docker
# Desktop, Ubuntu perché il servizio control-plane ha già
# extra_hosts: host.docker.internal:host-gateway in docker-compose.yml,
# Docker 20.10+) — di norma non serve toccare questo default.
# HOSTCTL_URL=http://host.docker.internal:8765

# ── SHELL_RUN: comandi reali sull'host, senza una shell ─────────────────────
# Stage 1 di docs/host-access.md. Esegue un ARGV (mai una stringa di shell):
# l'eseguibile deve stare nell'allowlist per nome, il cwd dentro le directory
# ammesse, output e tempo li taglia il server. Gira con i permessi di chi avvia
# hostctl/agent.py: accenderlo e' una decisione consapevole, non un default.
# Con questo spento il tool `shell_run` non compare nel catalogo (chat, MCP,
# /tools/execute), quindi il modello non lo vede nemmeno.
# SHELL_RUN_ENABLED=false
# SHELL_ALLOWED_EXECUTABLES=python,node,npm,pytest,git
# SHELL_ALLOWED_DIRS=                 # vuoto = radice del repository
# SHELL_MAX_TIMEOUT=60
# SHELL_MAX_OUTPUT_BYTES=65536

# Conferma sui comandi distruttivi (shared/shell_policy.py): `git push`, `rm -r`,
# `npm publish`, `docker system prune`, `systemctl restart`... richiedono
# confirm=true. I livelli sono read < write < destructive oppure `none`.
# SHELL_CONFIRM_RISK=destructive      # `write` chiede anche per npm install, `none` non chiede mai
# SHELL_BLOCK_RISK=none               # `destructive` = rifiutati anche con confirm=true

# Sessioni (shell_session): un cwd che resta e un confine di audit, senza PTY.
# SHELL_MAX_SESSIONS=2                # il terzo `open` viene rifiutato
# SHELL_SESSION_IDLE_S=900            # una sessione inattiva scade (e sparisce dal list)
# SHELL_SESSION_HISTORY=50            # comandi ricordati per sessione (history_dropped dice il resto)

# Nome dell'interfaccia WireGuard che le azioni wg_up/wg_down controllano.
# WIREGUARD_INTERFACE=wg0

# Windows: path del file .conf usato da wireguard.exe /installtunnelservice.
# L'agent deve girare elevato per installare/rimuovere il tunnel service.
# WIREGUARD_CONFIG=C:\Users\tuo-utente\.wireguard\wg0.conf
# Override opzionale se wireguard.exe non e' nel PATH/path standard.
# WIREGUARD_EXECUTABLE=C:\Program Files\WireGuard\wireguard.exe
# WG_EXECUTABLE=C:\Program Files\WireGuard\wg.exe

# Override opzionale per il client Tailscale su Windows se non viene trovato
# nel PATH o sotto C:\Program Files\Tailscale.
# TAILSCALE_EXECUTABLE=C:\Program Files\Tailscale\tailscale.exe

# Secondi di scansione per l'azione ble_scan del pannello Network (default 6,
# tetto massimo 30 lato agent). Richiede `pip install bleak` sull'host —
# unica dipendenza esterna di hostctl/agent.py, opzionale.
# BLE_SCAN_SECONDS=6

# ── BOTTIGLIE (discovery firmato + proof-of-work) ────────────────────────────
# Vedi docs/network-panel.md. Bit di difficoltà del proof-of-work sono
# hardcoded in shared/bottle.py (DEFAULT_DIFFICULTY_BITS=20, ~1-2s di mining
# su una CPU moderna) — cambiali lì se serve, non sono ancora esposti come
# env var.

# Relay di default a cui questo nodo pubblica il proprio annuncio quando
# clicchi "Annuncia questo nodo". Il browser non puo' scegliere un URL
# arbitrario: evita SSRF e annunci firmati verso destinazioni non configurate.
# Vuoto = pubblica su se stesso.
# BOTTLE_RELAY_URL=

# Quante bottiglie distinte (una per pubkey) il relay di questo nodo tiene
# in memoria prima di scartare la più vecchia.
# BOTTLE_MAX_COUNT=500

# Secondi dopo i quali una bottiglia è considerata scaduta e viene ignorata/
# rimossa, sia in pubblicazione sia in lettura.
# BOTTLE_MAX_AGE_S=3600

# Quante pubblicazioni accetta questo relay dallo stesso IP in un'ora. Difesa
# in profondità oltre al proof-of-work, non l'unica barriera.
# BOTTLE_RATE_MAX_PER_HOUR=20

# Tetto alle finestre IP tenute in memoria dal rate limiter.
# BOTTLE_RATE_MAX_IPS=4096

# Segreto condiviso fra federation-gateway e control-plane per attestare
# l'IP pubblico reale di chi pubblica/legge bottiglie tramite il gateway
# (bootstrap pubblico indipendente, vedi docs/network-panel.md). Sotto i 32
# caratteri conta come "non configurato": il CP ricade su request.remote_addr
# (che dietro il gateway e' l'IP Docker interno del gateway stesso, non del
# vero chiamante — il rate-limit per-IP diventa un unico contatore condiviso,
# non rotto, solo meno preciso). Va nello stesso .env letto da entrambi i
# servizi. Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# Hermes Agent is the authoritative memory backend. The authenticated bridge
# runs natively so Hermes retains ownership of state.db and MEMORY.md locks.
MEMORY_BACKEND=hermes
HERMES_MEMORY_URL=http://host.docker.internal:8098
# Required: python -c "import secrets; print(secrets.token_hex(32))"
HERMES_MEMORY_TOKEN=
# Alternative consigliata: file ignorato da Git e montato in /repo dal CP.
HERMES_MEMORY_TOKEN_FILE=/repo/data/hermes-memory.token

# BOTTLE_GATEWAY_SECRET=

# Solo per il federation-gateway, quando e' dietro UN SOLO reverse proxy
# fidato davanti (es. Caddy) che imposta lui stesso X-Forwarded-For: legge
# il primo hop di quell'header invece della connessione TCP diretta. Non
# abilitare se davanti c'e' piu' di un proxy o un tunnel che non normalizza
# l'header — un client potrebbe falsificare gli hop successivi al primo.
# TRUST_PROXY_HEADERS=false

# Rate-limit del federation-gateway sulle route bottle pubbliche, PRIMA che
# la richiesta arrivi al control-plane (oltre al rate-limit e al
# proof-of-work gia' nel CP — difesa in profondità).
# GATEWAY_BOTTLE_PUBLISH_MAX_PER_HOUR=20
# GATEWAY_BOTTLE_LIST_MAX_PER_MINUTE=30
# Limiti per i browser node che entrano dal gateway pubblico. Nessuna di queste
# route permette di creare task o leggere lo stato della mesh.
# GATEWAY_WEB_REGISTER_MAX_PER_MINUTE=12
# GATEWAY_WEB_POLL_MAX_PER_MINUTE=30
# GATEWAY_WEB_RESULT_MAX_PER_MINUTE=30
# Chat pubblica: tempo massimo di attesa del modello e quote per IP.
# GATEWAY_CHAT_TIMEOUT_S=600
# GATEWAY_MODELS_MAX_PER_MINUTE=30
# GATEWAY_CHAT_MAX_PER_MINUTE=12
# GATEWAY_BOTTLE_RATE_MAX_IPS=4096

# ── BACKEND DS4 (DwarfStar) ──────────────────────────────────────────────────
# ds4-server (github.com/antirez/ds4) serve DeepSeek V4 Flash/PRO, GLM 5.x e
# Qwen3.8 Flash Next con API OpenAI-style su http://127.0.0.1:8000.
# Il modello NON si sceglie a runtime: lo decide il GGUF passato a ds4-server
# all'avvio; i nomi accettati (deepseek-v4-flash, glm-5.3-flash, ...) sono
# ALIAS di compatibilita. Il nodo lo raggiunge con:
#   INFERENCE_BACKEND=ds4
#   DS4_URL=http://host.docker.internal:8000
# ATTENZIONE: ds4-server NON ha autenticazione. Non esporlo sulla LAN o su
# Tailscale senza un proxy che aggiunga auth e TLS davanti.
# Hardware minimo reale: Metal 96GB+ (o SSD streaming con --ssd-streaming),
# CUDA single/multi-GPU, ROCm su Strix Halo. Il target piu piccolo
# (ds4f-q2, DeepSeek V4 Flash Q2) pesa ~81 GiB.
# Stato nodo: GET /metrics sul nodo usa /v1/models di ds4; throughput e
# latenza restano osservati dal log interazioni locale.

# ── BUDGET DI TEMPO DI UNA RICHIESTA ────────────────────────────────────────
# Due meccanismi distinti, entrambi nati da un test reale: deepseek-r1:8b con
# 600 token di risposta NON concludeva entro i 180s fissi, ne' sul nodo Windows
# ne' su Ollama locale (Read timed out). I modelli reasoning consumano decine di
# secondi di thinking prima che la risposta cominci, e con ds4 il thinking e'
# acceso di default.
#
# 1. Timeout del SINGOLO tentativo, scelto in base al modello.
#      INFERENCE_TIMEOUT_S=180            modelli diretti
#      INFERENCE_TIMEOUT_REASONING_S=600  modelli che ragionano (qwen3,
#                                         deepseek-r1, deepseek-v4, magistral,
#                                         glm-5, qwen3.8)
#      REASONING_MODELS=                  override dei pattern, separati da
#                                         virgola ("*" = tutti). Stessa semantica
#                                         di TOOL_CAPABLE_MODELS: un modello
#                                         nuovo non richiede una patch al codice.
#
# 2. Budget TOTALE della richiesta, condiviso dalla catena di fallback (nodo ->
#    federazione -> OmniRoute -> ollama-direct). Prima ogni stadio aveva il suo
#    timeout e la catena li SOMMAVA: oltre tre minuti per poi fallire. Ora si
#    smette quando il residuo non basta piu' per un tentativo utile, con HTTP 504
#    e un messaggio esplicito.
#      REQUEST_DEADLINE_S=660             default = INFERENCE_TIMEOUT_REASONING_S
#                                         + FALLBACK_MIN_ATTEMPT_S. Un budget piu'
#                                         corto verrebbe SFORATO dal primo
#                                         tentativo: osservato in test reale
#                                         ("budget di 300s esaurito dopo 600s").
#                                         Il controllo avviene FRA gli stadi, non
#                                         dentro un tentativo.
#      FALLBACK_MIN_ATTEMPT_S=60
#
# Lato nodo (devono stare SOPRA i valori del CP, altrimenti tagliano per primi e
# il CP interpreta un backend lento come un backend assente):
#      NODE_INFERENCE_TIMEOUT_S=600       node/main.py
#      OLLAMA_TIMEOUT_S=600               node/ollama_proxy.py, ultimo hop

# =========================
# COMPATIBILITA' DI PROTOCOLLO (control-plane <-> nodi)
# =========================
# Ogni nodo dichiara in /status e alla registrazione la versione del CONTRATTO
# con il control-plane: `protocol_version` in shared/node_compat.py. Serve a
# distinguere "nodo aggiornato" da "nodo compatibile". Un nodo che gira
# un'immagine vecchia risponde a /health e sembra sano, ma non ha le rotte che il
# CP si aspetta — e' successo davvero, e la differenza si e' vista solo sondando
# a mano /models/capabilities (404 su un control-plane, 200 sull'altro).
#
#   NODE_PROTOCOL_MODE=advisory   (default) segnala e lascia passare. NON esclude
#                                 un nodo che non dichiara la versione: escluderlo
#                                 espellerebbe dalla mesh un nodo che funziona,
#                                 per un dato che prima non esisteva. Un avviso
#                                 per nodo, una volta sola.
#                      strict    filtra: entrano fra i candidati del routing solo
#                                 i nodi al protocollo esatto.
NODE_PROTOCOL_MODE=advisory
