# ============================================================
# HyperSpace AGI v1.02 — .env.example
# Copia in .env e modifica solo le variabili che ti riguardano.
# Il registro pubblico è già configurato: i peer vengono
# scoperti automaticamente al boot — non serve BOOT_PEERS.
# ============================================================

# ── OBBLIGATORIO ────────────────────────────────────────────
# Il tuo endpoint pubblico (ngrok, tailscale funnel, VPS, ecc.)
# I peer della mesh lo usano per contattarti.
PUBLIC_ENDPOINT=https://il-tuo-tunnel.ngrok-free.app

# ── INFERENCE ───────────────────────────────────────────────
# URL del tuo backend di inferenza locale (Ollama o LM Studio)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# ── REGISTRY ────────────────────────────────────────────────
# Registry pubblico fisso — non cambiarlo se usi la mesh pubblica.
# Cambialo solo se vuoi una mesh privata.
REGISTRY_PUBLIC_URL=https://sanctuary-mower-plated.ngrok-free.dev

# ── OPZIONALI ───────────────────────────────────────────────
# Tier forzato del nodo: root | hub | leaf (lascia vuoto = auto)
# NODE_TIER=hub

# VRAM del tuo GPU in GB (0 = CPU only, auto-detected se nvidia-smi presente)
# VRAM_GB=8

# Secondi prima che un peer venga marcato stale (default 120)
# PEER_MAX_AGE_S=120

# Secondi TTL nodi nel registry (default 300)
# NODE_TTL=300

# Porta locale del nodo (default 8084)
# NODE_PORT=8084

# Firma crittografica inter-nodo (default true — non disabilitare in produzione)
# SIGN_REQUESTS=true

# Peer manuali da contattare al boot (opzionale — auto-discovery se vuoto)
# BOOT_PEERS=https://peer1.ngrok-free.app,https://peer2.ngrok-free.app

# Control plane URL (solo se hai un CP separato dalla mesh pubblica)
# CONTROL_PLANE_URL=https://il-tuo-cp.ngrok-free.app

# Porta locale del wizard di primo avvio (default 8088, http://localhost:8088)
# ONBOARDING_PORT=8088

# Etichetta libera per identificare a colpo d'occhio a cosa serve il nodo
# NODE_SPECIALIZATION=generalist

# Emoji che rappresenta il nodo nelle dashboard
# NODE_AVATAR=🤖

# ── FALLBACK ESTERNO (OmniRoute) ───────────────────────────────
# Ultimo livello di fallback quando nessun nodo della mesh (locale o
# federato) può rispondere: inoltra la richiesta a OmniRoute
# (https://github.com/diegosouzapw/OmniRoute), gateway verso 278+ provider
# AI esterni. Funziona già senza configurazione (provider free-tier di
# default). Per collegare provider propri: apri http://<host>:20128 dalla
# dashboard e copia la API key da Endpoints.
# OMNIROUTE_ENABLED=true
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=auto

# Compressione prompt (Caveman, via l'endpoint reale di OmniRoute) per i
# prompt lunghi diretti ai nodi della mesh locale — disattivata di default,
# perché comprime il fraseggio e va testata sul proprio caso d'uso prima di
# attivarla. modes: lite | standard | aggressive | ultra | rtk | stacked.
# PROMPT_COMPRESSION_ENABLED=false
# PROMPT_COMPRESSION_MODE=standard
# PROMPT_COMPRESSION_MIN_CHARS=200

# Secondi massimi che una richiesta aspetta in coda su un nodo saturo prima
# di ricevere 503 node_busy_timeout — il control-plane a quel punto prova
# il nodo successivo per score (default 60)
# REQUEST_QUEUE_TIMEOUT_S=60

# Quanti nodi candidati (per score) il control-plane prova in sequenza
# prima di ricadere su ollama-direct/federazione (default 3)
# ROUTING_MAX_CANDIDATES=3

# Pesi dello scoring di routing (VRAM pesa di più: i nodi CPU-only, anche
# se liberi, sono strutturalmente lenti e vanno preferiti solo come ultima
# risorsa). Non serve che sommino esattamente a 1 — sono pesi relativi.
# ROUTING_WEIGHT_VRAM=0.55
# ROUTING_WEIGHT_LOAD=0.25
# ROUTING_WEIGHT_TIER=0.10
# ROUTING_WEIGHT_UPTIME=0.10

# Capacità totale del nodo in "unità di carico" invece che in numero di
# richieste — un modello grande pesa proporzionalmente di più di uno
# piccolo. 1 unità ~= un modello nella fascia 7B servito in una singola
# richiesta (riferimento comodo, non una misura fisica: vedi
# estimate_model_load_units in node/main.py).
#
# NON è "quanti modelli entrano in VRAM": è quante GENERAZIONI CONCORRENTI
# il nodo regge senza saturare — dipende da quanta VRAM avanza dopo aver
# caricato il modello, non dalla VRAM totale. Su CPU pura il collo di
# bottiglia sono i core, non la memoria: la concorrenza aiuta poco, meglio
# tenerlo basso a prescindere dalla RAM disponibile.
#
# Punti di partenza (da ritarare guardando il badge Load e i tok/s nella
# dashboard: se compaiono 503 node_busy_timeout, abbassa; se il tok/s per
# richiesta non cala sotto carico concorrente, puoi alzarlo):
#
#   Hardware                          Modello tipico       MAX_LOAD_UNITS
#   ─────────────────────────────────────────────────────────────────────
#   Solo CPU (qualunque RAM)           qualsiasi             1
#   GPU 8 GB VRAM                      7B quantizzato         1–2
#   GPU 12 GB VRAM                     7B / 13B quantizzato    2–3
#   GPU 16 GB VRAM                     13B–14B                3–4
#   GPU 24 GB VRAM                     13B–14B, più margine    4–6
#   GPU 48 GB VRAM (es. doppia 24GB)   14B–34B                8–10
#   GPU 80 GB VRAM (A100/H100 class)   34B–70B, batching reale 15–20
#
# Esempio pratico: nodo con 16 GB VRAM che serve principalmente
# qwen2.5-coder-14b (peso ~2 unità, 14/7) e vuole reggere 2 richieste
# concorrenti di quel modello -> MAX_LOAD_UNITS=4. Se invece serve
# soprattutto un 3B leggero (peso ~0.5), lo stesso hardware regge molte
# più richieste in parallelo -> puoi alzarlo.
# MAX_LOAD_UNITS=0.5

# Override manuale del peso per modelli specifici, quando l'euristica sul
# nome (regex sul suffisso parametri, es. "14b") non è affidabile. JSON
# {"sottostringa-nome-modello": peso}.
# NODE_MODEL_WEIGHTS={"qwen2:0.5b": 0.25, "my-custom-gguf": 2.0}

# Peso di default per modelli senza suffisso parametri riconoscibile
# DEFAULT_MODEL_WEIGHT=1.0

# Motore d'inferenza servito da questa installazione — letto sia dal nodo
# (esposto in /status per lo scoring) sia dal control-plane (label nel
# fallback ollama-direct). Un solo valore, propagato a entrambi i servizi
# da docker-compose.yml.
# INFERENCE_BACKEND=ollama

# Peso dello scoring dedicato al motore d'inferenza, lato control-plane
# ROUTING_WEIGHT_ENGINE=0.15

# Punteggio 0..1 per motore, lato control-plane. JSON {"motore": punteggio}.
# Motori non elencati ricadono su ENGINE_SCORE_DEFAULT (0.5).
# ENGINE_SCORES={"ollama": 0.5, "vllm": 1.0, "tgi": 0.9, "llama.cpp": 0.7, "lmstudio": 0.4}
# ENGINE_SCORE_DEFAULT=0.5
