# =========================
# HYPERSPACE / HOST
# =========================
TZ=Europe/Rome
HOST_ROLE=primary-brain
HOST_NAME=changeme-host
LOG_LEVEL=info

# Base paths Windows
HS_ROOT=C:\HyperSpace
HS_CONFIG_DIR=C:\HyperSpace\config
HS_DATA_DIR=C:\HyperSpace\data
HS_MEMORY_DIR=C:\HyperSpace\memory
HS_LOG_DIR=C:\HyperSpace\logs

# =========================
# OLLAMA HOST (Windows host)
# =========================
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_CHAT_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_RAW_BASE_URL=http://host.docker.internal:11434

# General model
HS_MODEL_GENERAL=qwen3-14b-uncensored
HS_MODEL_GENERAL_FALLBACK=qwen3-14b-abliterated

# Coder model
HS_MODEL_CODER=qwen2.5-coder-14b-abliterated
HS_MODEL_CODER_FALLBACK=qwen2.5-coder-14b-instruct

# Routing / behavior
HS_DEFAULT_MODEL_ROLE=general
HS_ENABLE_MODEL_ROUTING=true
HS_ENABLE_CODE_AGENT=true
HS_ENABLE_MEMORY=true
HS_ENABLE_TOOL_USE=true

# =========================
# OLLAMA RUNTIME TUNING
# =========================
OLLAMA_KEEP_ALIVE=12h
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_QUEUE=64
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_LOAD_TIMEOUT=15m
OLLAMA_REQUEST_TIMEOUT=300
OLLAMA_CONTEXT_LENGTH=8192

# =========================
# NETWORK (Tailscale — non usato al momento: vedi MESH sotto)
# =========================
# Queste variabili non sono lette da nessun servizio/compose oggi
# (verificato 2026-09-13: zero occorrenze fuori da questo file).
# Restano qui come intento futuro; il meccanismo REALE usato ora per
# la mesh cross-machine è WireGuard, sotto.
TS_ENABLED=true
TS_HOSTNAME=changeme-host
TS_ACCEPT_DNS=true
TS_USE_FUNNEL=false
TS_USE_EXIT_NODE=false

# =========================
# MESH (WireGuard) — questa macchina è l'hub
# =========================
# Windows è l'hub sempre acceso della mesh Mac/Ubuntu/Windows — vedi
# docs/wireguard-mesh-setup.md per il setup completo (chiavi, port-
# forward UDP 51820, wg0.conf). 10.13.13.1 = questa macchina sulla VPN.
#
# MESH_BIND_IP e' quello che conta davvero per l'esposizione delle
# porte: docker-compose.windows.yml pubblica ogni porta su
# ${MESH_BIND_IP:-127.0.0.1} — di default resta solo-localhost
# (comportamento invariato), va valorizzato qui SOLO dopo che
# `ping 10.13.13.1` funziona da Mac e Ubuntu, altrimenti le porte
# restano chiuse ai peer e la VPN da sola non basta.
MESH_BIND_IP=10.13.13.1
PUBLIC_ENDPOINT=http://10.13.13.1:8084
REGISTRY_PUBLIC_URL=http://10.13.13.1:8086

# =========================
# CONTAINERS
# =========================
COMPOSE_PROJECT_NAME=hyperspace
RESTART_POLICY=unless-stopped

# =========================
# SECURITY
# =========================
# EXPOSE_PUBLIC_PORTS / BIND_LOCALHOST_ONLY / ALLOW_TAILSCALE_REMOTE:
# stesso discorso di TS_* sopra — non letti da nessun codice oggi,
# solo intento documentato. Il controllo reale è MESH_BIND_IP sopra.
EXPOSE_PUBLIC_PORTS=false
BIND_LOCALHOST_ONLY=true
ALLOW_TAILSCALE_REMOTE=true
